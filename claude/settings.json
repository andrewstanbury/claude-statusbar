{
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "includeGitInstructions": false,
  "skillListingMaxDescChars": 600,
  "fileCheckpointingEnabled": false,
  "cleanupPeriodDays": 7,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm *)",
      "Bash(dd if=* of=/dev/sd*)",
      "Bash(dd if=* of=/dev/nvme*)",
      "Bash(mkfs.* *)",
      "Bash(mkfs *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(chmod -R 777 /*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ]
  },
  "skillOverrides": {
    "write-a-skill": "user-invocable-only",
    "claude-api": "name-only"
  }
}
